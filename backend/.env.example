# Copy to .env (never commit .env)
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Supabase: Project Settings -> API. Use the SERVICE ROLE key (backend only!).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; required when APP_ENV=production.  e.g. python -c "import secrets;print(secrets.token_hex(32))"
REPORT_HASH_SALT=

# Set true only when running behind a reverse proxy you control (Render/Fly/etc.)
TRUST_PROXY_HEADERS=false

# Used by P's threat_reputation module
GOOGLE_SAFE_BROWSING_API_KEY=
